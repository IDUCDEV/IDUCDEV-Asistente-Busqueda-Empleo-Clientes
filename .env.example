# Copiar a `.env` (en la raíz) y rellenar. NUNCA commitear `.env`.
# Gmail requiere 2FA activado + "Contraseña de app":
#   https://myaccount.google.com/apppasswords

# Email desde el que se envían los mensajes a clientes
EMAIL_USER=iducdev.inc@gmail.com
EMAIL_APP_PASSWORD=

# Límite de envíos por día (cola de envíos)
ENVIO_MAX_DIA=12

# Pausa entre envíos de WhatsApp Web, en segundos (mín/máx)
ENVIO_PAUSA_WA_MIN=15
ENVIO_PAUSA_WA_MAX=35
